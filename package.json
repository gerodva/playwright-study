{
  "name": "playwright-study",
  "version": "1.0.0",
  "description": "Repositorio de estudio práctico de Playwright con TypeScript: casos reales E2E, Page Object Model, API Mocking y buenas prácticas de seguridad.",
  "private": true,
  "author": "gerodva (https://github.com/gerodva)",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:auth": "playwright test tests/01-autenticacion.spec.ts",
    "test:ecommerce": "playwright test tests/02-ecommerce-carrito.spec.ts",
    "test:dom": "playwright test tests/03-estado-y-dom.spec.ts",
    "test:network": "playwright test tests/04-red-y-api-mocking.spec.ts",
    "test:ui-avanzada": "playwright test tests/05-ui-avanzada.spec.ts",
    "test:report": "playwright show-report",
    "security:audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.13.0",
    "typescript": "^5.8.2"
  }
}
