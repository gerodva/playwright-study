# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ============================================================================
# INSTRUCCIONES DE SEGURIDAD:
# 1. Este archivo (.env.example) es seguro para subir a GitHub porque solo
#    documenta qué variables usa el proyecto (usando sitios públicos de demo).
# 2. Si deseas sobreescribir valores localmente, copia este archivo como `.env`:
#       cp .env.example .env
# 3. El archivo `.env` está bloqueado en `.gitignore` para que NUNCA se suba
#    por accidente al repositorio público.
# ============================================================================

# URLs base de los sitios públicos de estudio
SAUCE_BASE_URL=https://www.saucedemo.com
TODOMVC_BASE_URL=https://demo.playwright.dev/todomvc
THE_INTERNET_BASE_URL=https://the-internet.herokuapp.com

# Usuarios públicos de demostración oficial de SauceDemo
SAUCE_STANDARD_USER=standard_user
SAUCE_LOCKED_USER=locked_out_user
SAUCE_PASSWORD=secret_sauce
